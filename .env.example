# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Webhook secret (set when registering webhook with Telegram)
WEBHOOK_SECRET=your_webhook_secret_here

# Supabase (avatar-sdk project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# community-admin config seam (optional). When both are set, group config is read
# from community-admin's GET /api/config (60s cache); otherwise groups.json is used.
# The fallback marks nothing private, so a broken CA_CONFIG_URL does not error —
# it quietly makes private communities public. Check anonymous GET /api/groups
# after any change to these: it must NOT list a private community.
CA_CONFIG_URL=https://admin.citizeninfra.org/api/config
CA_CONFIG_SECRET=shared_secret_matching_community_admin

# Identity verification against community-admin as IdP.
# CA_ISSUER must equal community-admin's own API_URL exactly — that is what it
# stamps as `iss`, and it is a literal string compare. When CA moved host and
# this did not follow, every valid token was rejected silently for a day (#16).
CA_JWKS_URL=https://admin.citizeninfra.org/.well-known/jwks.json
CA_ISSUER=https://admin.citizeninfra.org
